        <mxCell id="bedrock" value="Amazon Bedrock&#10;Nova Lite: pie de foto y etiquetas&#10;Nova 2 Multimodal Embeddings&#10;Nova 2 Lite: el asistente&#10;(perfiles us.: también us-east-2&#10;y us-west-2)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#01A88D;resIcon=mxgraph.aws4.bedrock;verticalLabelPosition=middle;labelPosition=right;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1540" y="550" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="rekognition" value="Rekognition: personas (opt-in)&#10;una colección por usuario&#10;IndexFaces + Users (≥ 90 %)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#01A88D;resIcon=mxgraph.aws4.rekognition;verticalLabelPosition=middle;labelPosition=right;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1540" y="720" width="56" height="56" as="geometry"/></mxCell>
