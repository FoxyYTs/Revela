        <mxCell id="apigw" value="API Gateway HTTP jyj-revela-api&#10;autorizador JWT · 10 req/s&#10;/compartidos sin cuenta" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.api_gateway;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="352" y="580" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="scheduler" value="EventBridge Scheduler&#10;todos los días 7:00&#10;(America/Bogota)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.eventbridge;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="352" y="740" width="56" height="56" as="geometry"/></mxCell>
