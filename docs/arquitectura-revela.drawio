        <mxCell id="dynamo" value="DynamoDB jyj-revela-fotos&#10;tabla única, PK U#usuario&#10;GSI por-fecha · TTL" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#C925D1;resIcon=mxgraph.aws4.dynamodb;verticalLabelPosition=middle;labelPosition=right;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1060" y="550" width="56" height="56" as="geometry"/></mxCell>
