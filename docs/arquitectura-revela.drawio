        <mxCell id="s3fotos" value="S3 jyj-revela-fotos&#10;originales/ (temporal) · fotos/ (→ Glacier IR 30 d)&#10;miniaturas/ · publicas/ (sin EXIF)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#7AA116;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="sqs" value="SQS&#10;jyj-revela-fotos" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.sqs;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="940" y="150" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="dlq" value="DLQ jyj-revela-fotos-dlq&#10;(alarma si llega algo)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.sqs;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="940" y="300" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="pipes" value="EventBridge Pipes&#10;lote de 1 mensaje" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.eventbridge;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="sfn" value="Step Functions jyj-revela-analizar (JSONata, X-Ray): una ejecución por foto" style="sketch=0;html=1;whiteSpace=wrap;fontSize=13;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_step_functions_workflow;strokeColor=#E7157B;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#E7157B;dashed=0;" vertex="1" parent="1"><mxGeometry x="1220" y="112" width="720" height="330" as="geometry"/></mxCell>
        <mxCell id="p1" value="&lt;b&gt;1. Reclamar&lt;/b&gt;&lt;br&gt;escritura condicional&lt;br&gt;en DynamoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1240" y="160" width="120" height="62" as="geometry"/></mxCell>
        <mxCell id="procesar" value="2. Lambda procesar&#10;EXIF, miniatura 480 px,&#10;publica 2048 px (capa Pillow)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.lambda;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1402" y="162" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="paralelo" value="&lt;b&gt;3. En paralelo&lt;/b&gt; (Rekognition,&lt;br&gt;integración directa sobre fotos/)&lt;br&gt;DetectLabels · DetectText (OCR)&lt;br&gt;DetectModerationLabels&lt;br&gt;→ cuarentena si hay contenido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1560" y="150" width="190" height="104" as="geometry"/></mxCell>
        <mxCell id="guardar" value="4. Lambda guardar&#10;pie de foto, dirección,&#10;vector y caras" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.lambda;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1820" y="162" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="nota_sfn" value="Reclamar evita analizar dos veces la misma foto. guardar escribe la foto y sus índices (E# etiqueta, T# texto, L# lugar, P# persona) y, si el usuario activó personas, agrupa la cara con Rekognition Users. Si algo falla, «Marcar error» la deja en ERROR en DynamoDB. Si se llena el tope de 10 Lambdas simultáneas de la cuenta, Step Functions reintenta con espera (hasta 6 veces)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5FA;strokeColor=#E7157B;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1240" y="320" width="560" height="104" as="geometry"/></mxCell>
        <mxCell id="lambdas" value="Lambdas de la API (Python 3.12)" style="sketch=0;html=1;whiteSpace=wrap;fontSize=13;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#ED7100;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#ED7100;dashed=1;" vertex="1" parent="1"><mxGeometry x="630" y="500" width="350" height="530" as="geometry"/></mxCell>
        <mxCell id="api" value="jyj-revela-api (256 MB)&#10;fotos, búsqueda, personas, álbumes,&#10;recuerdos, importar de Google Fotos&#10;cupo: 50 fotos por usuario al día" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.lambda;verticalLabelPosition=middle;labelPosition=right;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="690" y="550" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="asistente" value="jyj-revela-asistente (512 MB, capa Strands)&#10;agente con Nova 2 Lite, 30 preguntas/día&#10;herramientas: buscar_fotos, personas,&#10;lugares, crear_album" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.lambda;verticalLabelPosition=middle;labelPosition=right;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="690" y="720" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="recuerdos" value="jyj-revela-recuerdos&#10;fotos de este día en años&#10;anteriores → álbum + correo&#10;(busca el correo en Cognito)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.lambda;verticalLabelPosition=middle;labelPosition=right;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="690" y="890" width="56" height="56" as="geometry"/></mxCell>
