        <mxCell id="titulo" value="Revela: galería de fotos inteligente en AWS (jyj, Computación en la Nube 2026-2)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1960" height="34" as="geometry"/></mxCell>
